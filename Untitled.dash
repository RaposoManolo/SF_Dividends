    "ds-chart-81628d7a9d91": {
      "type": "sql",
      "columns": [
        {
          "name": "YEAR(RECORD_DATE)",
          "type": "NUMBER"
        },
        {
          "name": "SUM(RECEIPT_GBP)",
          "type": "NUMBER"
        }
      ],
      "sql": " SELECT \n      --  STOCK_NAME,\n       yEAR(RECORD_DATE) ,\n        sum(RECEIPT_GBP)  \n   FROM DIVIDENDS_DEV.SILVER.DIVIDENDS\n   where  yEAR(RECORD_DATE) = 2026\n   GROUP BY 1--,2",
      "filter_bindings": []
    }
  }
