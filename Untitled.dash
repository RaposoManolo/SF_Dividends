        {
          "tile_id": "chart-81628d7a9d91",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "width": 400,
            "height": 200,
            "padding": 0,
            "params": [
              {
                "name": "__scorecard_reveal",
                "value": 1
              },
              {
                "name": "__scorecard_pulse",
                "value": 0
              }
            ],
            "data": {
              "name": "values"
            },
            "transform": [
              {
                "calculate": "(isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)'])) ? '£' + (abs(datum['SUM(RECEIPT_GBP)']) >= 1e9 ? format(datum['SUM(RECEIPT_GBP)'] / 1e9, '.2~f') + 'B' : abs(datum['SUM(RECEIPT_GBP)']) >= 1e6 ? format(datum['SUM(RECEIPT_GBP)'] / 1e6, '.2~f') + 'M' : abs(datum['SUM(RECEIPT_GBP)']) >= 1e3 ? format(datum['SUM(RECEIPT_GBP)'] / 1e3, '.2~f') + 'K' : format(datum['SUM(RECEIPT_GBP)'], ',.2~f')) : 'N/A'",
                "as": "bigNumberText"
              },
              {
                "calculate": "datum['SUM(RECEIPT_GBP)'] == null || datum['SUM(RECEIPT_GBP)'] == 0 ? null : (datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']) / datum['SUM(RECEIPT_GBP)'] * 100",
                "as": "__derivedDelta"
              },
              {
                "calculate": "!((isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)']))) ? '' : (((isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)']))) ? ((datum['__derivedDelta'] == null ? 'N/A' : format(abs(datum['__derivedDelta']), '.2f') + '%') + ' (' + (abs(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)'])) >= 1e9 ? format(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']) / 1e9, '.2~f') + 'B' : abs(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)'])) >= 1e6 ? format(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']) / 1e6, '.2~f') + 'M' : abs(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)'])) >= 1e3 ? format(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']) / 1e3, '.2~f') + 'K' : format(abs(datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']), ',.2~f')) + ')') : 'N/A')",
                "as": "deltaText"
              },
              {
                "calculate": "(isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)'])) && (isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)'])) ? ((datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']) >= 0 ? '#087959' : '#d3132f') : '#5d6a85'",
                "as": "deltaColor"
              },
              {
                "calculate": "(isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)'])) && (isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)'])) ? ((datum['SUM(RECEIPT_GBP)'] - datum['SUM(RECEIPT_GBP)']) >= 0 ? 'up' : 'down') : ''",
                "as": "deltaDirection"
              },
              {
                "calculate": "'neutral'",
                "as": "__toneKey"
              },
              {
                "calculate": "!(isValid(datum['SUM(RECEIPT_GBP)']) && isNumber(datum['SUM(RECEIPT_GBP)'])) ? '#5d6a85' : ('#1e252f')",
                "as": "__numberColor"
              },
              {
                "calculate": "'neutral'",
                "as": "__chartKey"
              },
              {
                "calculate": "'#3580f2'",
                "as": "__lineColor"
              },
              {
                "calculate": "'#3580f2'",
                "as": "__chartColor"
              }
            ],
            "layer": [
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "fontWeight": "bold",
                  "fontSize": {
                    "expr": "width >= 140 ? 40 : (width >= 90 ? 24 : 14)"
                  },
                  "limit": {
                    "expr": "width - 8"
                  },
                  "color": {
                    "expr": "datum['__numberColor']"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "width / 2"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 20"
                    }
                  },
                  "text": {
                    "field": "bigNumberText"
                  }
                }
              },
              {
                "name": "scorecard-trend-icon-up",
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  },
                  {
                    "calculate": "datum['deltaDirection'] == '' ? 0 : 16",
                    "as": "__iw"
                  },
                  {
                    "calculate": "scorecardTextWidth(datum['deltaText'], '600 12px Inter, Roboto, \\'Helvetica Neue\\', Arial, sans-serif')",
                    "as": "__dw"
                  },
                  {
                    "calculate": "0",
                    "as": "__cw"
                  },
                  {
                    "calculate": "max(4, width / 2 - (datum.__iw + datum.__dw + (datum.__cw > 0 ? 6 + datum.__cw : 0)) / 2)",
                    "as": "__ix"
                  },
                  {
                    "calculate": "datum.__ix + datum.__iw",
                    "as": "__dx"
                  },
                  {
                    "filter": "datum['deltaDirection'] == 'up'"
                  }
                ],
                "mark": {
                  "type": "point",
                  "shape": "M4.05 9.72a.5.5 0 0 1 .055-.527l3.5-4.5a.5.5 0 0 1 .79 0l3.5 4.5A.5.5 0 0 1 11.5 10h-7a.5.5 0 0 1-.45-.28",
